#!/bin/bash

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${YELLOW} Running pre-commit checks...${NC}"

# Change to repository root and backend directory
cd "$(git rev-parse --show-toplevel)/backend" || exit 1

# 1. Generate Swagger documentation
echo -e "\n${YELLOW} Generating Swagger documentation...${NC}"

# Try to find swag in common locations
SWAG_CMD=""
if command -v swag &> /dev/null; then
    SWAG_CMD="swag"
elif [ -f "$HOME/go/bin/swag" ]; then
    SWAG_CMD="$HOME/go/bin/swag"
elif [ -f "$(go env GOPATH)/bin/swag" ]; then
    SWAG_CMD="$(go env GOPATH)/bin/swag"
fi

if [ -n "$SWAG_CMD" ]; then
    $SWAG_CMD init -g cmd/soziodata/main.go -o ./docs --parseDependency --parseInternal
    if [ $? -eq 0 ]; then
        echo -e "${GREEN} Swagger documentation generated successfully${NC}"
        # Stage the generated files
        git add docs/docs.go docs/swagger.json docs/swagger.yaml
    else
        echo -e "${RED} Failed to generate Swagger documentation${NC}"
        exit 1
    fi
else
    echo -e "${YELLOW} swag command not found. Skipping Swagger generation.${NC}"
    echo -e "${YELLOW}  Install with: go install github.com/swaggo/swag/cmd/swag@latest${NC}"
fi

# 2. Run Go tests
echo -e "\n${YELLOW} Running Go tests...${NC}"
go test ./... -v
if [ $? -eq 0 ]; then
    echo -e "${GREEN} All tests passed${NC}"
else
    echo -e "${RED} Tests failed${NC}"
    echo -e "${RED} Commit aborted. Please fix the failing tests.${NC}"
    exit 1
fi

echo -e "\n${GREEN} All pre-commit checks passed!${NC}"
exit 0
