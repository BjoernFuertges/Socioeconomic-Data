# Local default: the superuser. In production the pipeline container overrides these values
# with DESTINATION__POSTGRES__CREDENTIALS__* env vars (role pipeline_rw; env beats secrets.toml).
[destination.postgres.credentials]
database = "soziooekonomische-daten"
username = "sozio_data_compose_user"
password = "compose_password"
host = "localhost"
port = 5432
