                    "Bevölkerung"
                ],
                "summary": "Bevölkerungsdaten abrufen",
                "parameters": [
                    {
                        "type": "string",
                        "example": "DEF01",
                        "description": "Filter nach NUTS-3-Code",
                        "name": "geodata_id_nuts",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "example": 2020,
                        "description": "Filter nach Jahr",
                        "name": "year",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 1000,
                        "example": 100,
                        "description": "Anzahl der Ergebnisse (1-10000)",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 0,
                        "example": 0,
                        "description": "Offset für Pagination",
                        "name": "offset",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/models.APIResponse"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/definitions/models.BevoelkerungData"
