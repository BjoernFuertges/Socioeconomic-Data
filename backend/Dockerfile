# =============================================================================
# Stage 1: Builder
# =============================================================================
FROM golang:1.26-alpine AS builder

# Release metadata injected via -ldflags (set by CI)
ARG VERSION
ARG BUILD_TIME

WORKDIR /app

# Download dependencies separately for layer caching
COPY go.mod go.sum ./
RUN go mod download

COPY . .

# Swagger docs are generated by the pre-commit hook and committed, so no swag step here.
# Static binary (no CGO needed); -w -s strips debug symbols.
RUN CGO_ENABLED=0 GOOS=linux go build -o /app/bin/server -ldflags "\
  -w -s \
  -X 'github.com/BjoernFuertges/Socioeconomic-Data/backend/internal/version.Version=${VERSION:-dev}' \
  -X 'github.com/BjoernFuertges/Socioeconomic-Data/backend/internal/version.BuildTime=${BUILD_TIME:-unknown}'" \
  ./cmd/soziodata

# =============================================================================
# Stage 2: Minimal runtime image
# =============================================================================
FROM alpine:3.21

# CA certificates and timezone data
RUN apk add --no-cache ca-certificates tzdata

# Run as non-root
RUN adduser -D -g '' appuser

ENV PORT=8080

WORKDIR /app

# .env.example lists the required env vars (checked at startup); configs/ holds
# metrics_catalog.yaml, without which the derived-metrics endpoints are empty.
COPY --from=builder /app/bin/server .
COPY --from=builder /app/.env.example .
COPY --from=builder /app/configs ./configs

USER appuser

EXPOSE ${PORT}

CMD ["./server"]
