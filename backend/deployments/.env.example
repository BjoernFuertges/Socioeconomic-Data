# Read automatically by `docker compose` for ${...} substitution
# (create a copy as backend/deployments/.env, do not commit).
# On the Hetzner server the deploy job (.github/workflows/main.yml)
# rewrites this file on every deploy from GitHub secrets/variables.
DB_PASSWORD=change_me

# Public hostname (Traefik routing, Let's Encrypt, Swagger)
APP_HOST=example.org
LE_EMAIL=admin@example.org

# GHCR namespace (GitHub owner, lowercase) and image tag.
# The deploy job sets IMAGE_TAG to sha-<short commit hash>.
GHCR_OWNER=bjoernfuertges
IMAGE_TAG=latest

# Optional: absolute path for the PostgreSQL data (e.g. Hetzner volume).
# Without it the named volume "pgdata" is used.
# PGDATA_DIR=/mnt/pgdata/data
